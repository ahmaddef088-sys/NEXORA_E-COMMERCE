# ─────────────────────────────────────────────────────────────────────────────
# Nexora Commerce — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexora?schema=public"

# ── Authentication ────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-long"

# JWT token expiry in seconds (default: 604800 = 7 days)
JWT_EXPIRES_IN_SECONDS="604800"

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_NAME="nexora_session"

# ── Inventory ─────────────────────────────────────────────────────────────────
# Products with stock at or below this number trigger low-stock alerts
LOW_STOCK_THRESHOLD="5"

# ── Optional: Email (Phase 16) ────────────────────────────────────────────────
# EMAIL_FROM=""
# EMAIL_PROVIDER=""   # e.g. "resend" | "sendgrid"
# RESEND_API_KEY=""

# ── Optional: Payment Provider (Phase 8) ─────────────────────────────────────
# PAYMENT_PROVIDER=""  # e.g. "stripe" | "paymob" | "mock"
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
